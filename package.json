{
  "name": "quizbot",
  "version": "4.0.0",
  "description": "Discord bot for managing a pub quiz — team registration, scoring, leaderboards",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "NODE_OPTIONS='--throw-deprecation' tsx watch src/index.ts",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "firebase emulators:exec --only firestore --project demo-quizbot 'NODE_OPTIONS=\"--throw-deprecation\" npx vitest run --config vitest.integration.config.ts'"
  },
  "keywords": [
    "discord",
    "quiz",
    "bot"
  ],
  "author": "CharliW90",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "firebase-admin": "^14.5.1",
    "googleapis": "^190.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
